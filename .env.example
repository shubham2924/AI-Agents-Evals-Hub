PORT=3000
DATABASE_PATH=./data/agent-evals.db
HERMES_BIN=hermes
# Direct OpenAI API key used by Hermes. Never commit your real key.
OPENAI_API_KEY=
# Set to true only when debugging raw Hermes profile files after a run.
KEEP_HERMES_PROFILES=false
# Maximum simultaneous Hermes processes. Keep low to respect provider limits.
RUN_CONCURRENCY=2
